<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.2</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.bikestore</groupId>
	<artifactId>bikestore-async</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>BikeStore Async</name>
	<description>Demostración académica de pedidos asíncronos para una tienda de bicicletas con Spring Boot y RabbitMQ.</description>
	<url>https://github.com/Juliomm8/bikestore-async</url>
	<scm>
		<connection>scm:git:https://github.com/Juliomm8/bikestore-async.git</connection>
		<developerConnection>scm:git:ssh://git@github.com/Juliomm8/bikestore-async.git</developerConnection>
		<url>https://github.com/Juliomm8/bikestore-async</url>
	</scm>
	<properties>
		<java.version>17</java.version>
	</properties>
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-amqp</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-amqp-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

	<!-- Permite crear un JAR sin sobrescribir el que usa una JVM activa en Windows. -->
	<profiles>
		<profile>
			<id>empaquetado-alternativo</id>
			<build>
				<directory>${project.basedir}/target/empaquetado-alternativo</directory>
			</build>
		</profile>
	</profiles>

</project>
